# ==============================================================================
# Papelito — Configuración de Variables de Entorno (.env.example)
# Copia este archivo a .env.local y completa los valores con tus credenciales.
# NOTA: Nunca confirmes tus claves reales al repositorio (.env.local está en .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon PostgreSQL (Persistencia Transaccional Exclusiva en Servidor)
# Obtenidas con `neon deploy` / `neon env pull` o desde Neon Console -> Connection Details
# IMPORTANTE: Usa el proyecto y base de datos de Neon dedicados exclusivamente
# a Papelito. No reutilices bases de datos de otras aplicaciones.
# ------------------------------------------------------------------------------
# Conexión pooled (-pooler) para el tráfico normal de la aplicación Next.js / Netlify
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Conexión directa sin pooler (sin el sufijo -pooler en el host) exclusiva para migraciones (`npm run db:migrate`)
DATABASE_URL_UNPOOLED=postgresql://usuario:password@ep-ejemplo.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Neon Auth — Managed Better Auth (Autenticación SSR y Google OAuth)
# Obtenida con `neon deploy` / `neon env pull` o desde Neon Console -> Auth
# ------------------------------------------------------------------------------
# URL base del servicio Neon Auth de la rama vinculada
NEON_AUTH_BASE_URL=https://ep-ejemplo.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Secreto criptográfico de al menos 32 caracteres para firmar cookies de sesión SSR
# Puedes generar uno con: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=reemplazar_con_secreto_aleatorio_de_al_menos_32_caracteres

# Secreto criptográfico de al menos 32 caracteres para cifrar tokens de invitación
# en servidor (AES-256-GCM). Si se rota esta clave, los tokens previos dejan de
# descifrarse y el organizador puede emitir un enlace nuevo desde la interfaz.
INVITATION_TOKEN_SECRET=reemplazar_con_secreto_invitaciones_de_al_menos_32_caracteres

# ------------------------------------------------------------------------------
# 3. URL pública base de la aplicación (Local o Netlify)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3040

# Web Push: opcional. Si no se indican ambas claves, Papelito deriva una pareja VAPID
# estable del INVITATION_TOKEN_SECRET existente mediante HKDF y un contexto exclusivo.
# No rotar ese secreto sin planificar la renovación de las suscripciones push.
# PUSH_VAPID_PUBLIC_KEY=clave_publica_p256_base64url
# PUSH_VAPID_PRIVATE_KEY=clave_privada_p256_base64url
