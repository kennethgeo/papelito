{
  "name": "papelito",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "db:migrate": "node scripts/db-migrate.mjs",
    "privacy:delete": "node --conditions=react-server --experimental-strip-types scripts/privacy-delete.mjs",
    "test:draw": "node --experimental-strip-types scripts/test-draw.mjs",
    "test:lifecycle": "node --conditions=react-server --experimental-strip-types scripts/test-lifecycle.mjs",
    "test:hardening": "node --conditions=react-server --experimental-strip-types scripts/test-hardening.mjs",
    "test:concurrency": "node --conditions=react-server --experimental-strip-types scripts/test-concurrency.mjs",
    "test:backend": "node --conditions=react-server --experimental-strip-types scripts/test-backend.mjs",
    "test:neon": "node --conditions=react-server --experimental-strip-types scripts/test-neon.mjs",
    "test:ux": "node --experimental-strip-types scripts/test-ux.mjs && npm run test:db:workers",
    "test:db:workers": "node --experimental-test-module-mocks --conditions=react-server --experimental-strip-types scripts/test-db-workers.mjs",
    "test:journey": "node --conditions=react-server --experimental-strip-types scripts/test-journey.mjs",
    "test:dashboard": "node --conditions=react-server --experimental-strip-types scripts/test-dashboard.mjs",
    "test:e2e": "playwright test",
    "test:e2e:workerd": "PAPELITO_E2E_WORKERD=1 playwright test",
    "test:neon:e2e": "node --conditions=react-server --experimental-strip-types scripts/test-neon-journey.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:workerd": "node scripts/test-workerd.mjs && node scripts/test-workerd-push.mjs",
    "test:selected": "node --conditions=react-server --experimental-strip-types scripts/test-selected.mjs",
    "test:organization": "node --conditions=react-server --experimental-strip-types scripts/test-organization.mjs",
    "support:list": "node scripts/support-list.mjs",
    "test:social": "node --conditions=react-server --experimental-strip-types scripts/test-social.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "node scripts/deploy-cloudflare-web.mjs",
    "deploy:cloudflare:jobs": "wrangler deploy --config cloudflare/scheduler.wrangler.jsonc",
    "check:cloudflare:jobs": "wrangler deploy --dry-run --config cloudflare/scheduler.wrangler.jsonc"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@vinext/cloudflare": "1.3.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "vinext": "1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.6",
    "@cloudflare/config": "0.29.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "cf": "1.0.0-beta.26",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "8.16.3",
    "typescript": "^5",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  }
}
